{
  "meta": {
    "title": "Ghana Universities & Campuses Dataset",
    "purpose": "Reference data for UniMarket onboarding — university + campus selection",
    "compiled": "2026-07-01",
    "sources": [
      "Wikipedia: List of universities in Ghana",
      "Ghana Tertiary Education Commission (GTEC, formerly NAB) accreditation lists",
      "Individual university websites (uds.edu.gh, ug.edu.gh, uew.edu.gh, umat.edu.gh, etc.)",
      "uniRank.org 2026 Ghana listing"
    ],
    "notes": "Where a university operates multiple physical campuses/sites, each is listed separately under 'campuses'. Single-site institutions have one campus entry equal to the main location. Accreditation and campus status change over time in Ghana (e.g. former UEW satellite campuses at Kumasi/Mampong became the independent AAMUSTED in 2020) — recommend a periodic re-check against GTEC's published list before treating this as permanently authoritative.",
    "verification_note": "verified:true = campus list cross-checked in this pass directly against the institution's own official website/press releases (not aggregators). Verified so far: AAMUSTED, BCUC, Central, GCTU, KNUST, MUG, PUC, Radford, UCC, UDS, UENR, UEW, UG, UHAS, UMaT. All other entries (verified:false) — mostly single-campus private colleges plus a few still-unconfirmed multi-campus private ones (e.g. Data Link, Anglican, Koforidua Technical University's Somanya campus) — were compiled from secondary sources (Wikipedia, uniRank, aggregator profiles) and have NOT yet been individually confirmed against each institution's own site. Treat those as a starting point, not verified fact, and re-check before shipping to production, especially for any institution your users will actually select often.",
    "known_correction_history": [
      "UMaT: added Essikado (SRID) campus, missed in first pass.",
      "KNUST: removed invented Kumasi City Campus and Sunyani affiliation; confirmed Obuasi campus is real.",
      "UCC: corrected from 3 campuses to the actual 2 (South/Old Site, North/New Site).",
      "UENR: added missing Nsoatre campus (3 campuses total, not 2).",
      "AAMUSTED: removed invented Asokore-Mampong campus; only Kumasi + Asante-Mampong exist.",
      "GCTU: removed incorrect Tamale campus; corrected to Tesano/Abeka/Kumasi as full campuses plus 4 distance learning centres.",
      "Central University: removed incorrect Tema campus; added Christ Temple and Kumasi campuses.",
      "Presbyterian University: added missing Kumasi (Santasi) campus; confirmed 5 total.",
      "Radford University College: removed unconfirmed Kumasi campus (single-campus institution).",
      "Zenith University College: removed unconfirmed Kumasi campus, downgraded to unverified single Accra campus pending confirmation."
    ]
  },
